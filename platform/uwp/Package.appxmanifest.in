<?xml version="1.0" encoding="utf-8"?>
<!-- The Xbox One / Windows package (UWP). Publisher must match the subject of the certificate CI signs it with. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="AmherstRun" Publisher="CN=AmherstRunDev" Version="@AMR_PKG_VERSION@" />
  <mp:PhoneIdentity PhoneProductId="b5ca51e3-61d1-4051-9d0a-7ee860b73bb9" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Amherst Run</DisplayName>
    <PublisherDisplayName>Amherst Run</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="AmherstRun.App">
      <uap:VisualElements DisplayName="Amherst Run" Description="Retro arcade driving around Amherst, Nova Scotia"
                          BackgroundColor="#1d3c8a" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1d3c8a" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="landscape" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
